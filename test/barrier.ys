# $barrier cells are transparent: the view links and times as the same design
# without them (test/barrier_ref.tcl reads it after `optbarriers -remove`).
read_liberty -lib test/simple.lib
read_verilog test/barrier.v
prep -barriers -top top
select -assert-min 5 t:$barrier
opensta_net -liberty test/simple.lib -link
opensta_net -source test/barrier_body.tcl
optbarriers -remove
opt_clean
select -assert-none t:$barrier
write_verilog -noattr test/barrier_out.v
