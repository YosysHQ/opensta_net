# Constraints on hierarchical objects survive flatten: the sync re-applies
# them all, write_sdc prints the same SDC (flat_report.tcl dumps it) and
# timing is unchanged.
read_liberty -lib test/simple.lib
read_verilog test/flat.v
hierarchy -top top
opensta_net -liberty test/simple.lib -link
opensta_net -sdc test/flat.sdc
opensta_net -source test/flat_report.tcl
flatten
opensta_net -sync
opensta_net -source test/flat_report.tcl
select -assert-count 2 t:$scopeinfo
