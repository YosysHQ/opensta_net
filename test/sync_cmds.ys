# One constraint that no longer resolves must not drop the ones after it:
# only the two u_e constraints are lost.
read_liberty -lib test/simple.lib
read_verilog test/sync.v
hierarchy -top top
opensta_net -liberty test/simple.lib -link
opensta_net -sdc test/sync_cmds.sdc
delete top/u_e
opensta_net -sync
opensta_net -source test/sync_cmds_write.tcl
