# An unreported change (a rename) before the optimization: the view is
# already stale when the first reported change comes, yet the constraint set
# from raw Tcl still carries over, since the sync writes the constraints out
# of the stale view.
read_liberty -lib test/simple.lib
read_verilog test/sync.v
hierarchy -top top
opensta_net -liberty test/simple.lib -link
opensta_net -sdc test/sync_ports.sdc
tcl test/sync_rawtcl.tcl
cd top
rename e1 e1_renamed
cd ..
opt_merge -share_all
opt_clean -purge
opensta_net -sync
opensta_net -source test/sync_rawtcl_write.tcl
