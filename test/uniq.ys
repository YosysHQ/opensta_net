# Uniquified copies through OpenSTA's write_verilog: identical copies are one
# module, a copy edited in yosys gets its own (uniq_ref.tcl reads both back).
read_liberty -lib -ignore_miss_func deps/OpenSTA/test/nangate45/Nangate45_typ.lib
read_verilog test/uniq.v
hierarchy -top top
uniquify
opensta_net -liberty deps/OpenSTA/test/nangate45/Nangate45_typ.lib -link
opensta_net -source test/uniq_body.tcl
opensta_net -eval "write_verilog test/uniq_same.v"
chtype -set CLKBUF_X1 top.u2/b
opensta_net -source test/uniq_body.tcl
opensta_net -eval "write_verilog test/uniq_diff.v"
